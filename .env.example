# Application
APP_NAME="LegalBot API"
APP_ENV=development
APP_DEBUG=true

# Google Cloud / Vertex AI (prefer workload identity or ADC in production)
GCP_PROJECT_ID=your-google-cloud-project
GOOGLE_CLOUD_PROJECT=your-google-cloud-project
GCP_LOCATION=asia-southeast1
GOOGLE_APPLICATION_CREDENTIALS=

# Canonical RAG
RAG_ENABLED=true
RAG_ADMIN_API_KEY=replace-with-a-long-random-secret
RAG_CHAT_MODEL=gemini-2.5-flash
RAG_EMBEDDING_MODEL=models/gemini-embedding-001
RAG_EMBEDDING_DIMENSION=768
RAG_HISTORY_TURNS=6
RAG_VECTOR_CANDIDATES=20
RAG_LEXICAL_CANDIDATES=20
RAG_RRF_K=60
RAG_MAX_CONTEXT_CHARS=24000
RAG_LOW_CONTEXT_THRESHOLD=0.45
RAG_MAX_UPLOAD_MB=25
RAG_MAX_FETCH_MB=10
RAG_FETCH_TIMEOUT_SECONDS=30
RAG_INGEST_TOPIC=legal-ingest

# Storage and Pub/Sub
GCS_BUCKET=legalbot-documents
GCS_SA_KEY=
PUBSUB_TOPIC_ID=agreement-analysis

# AlloyDB connector (production)
USE_ALLOYDB=true
ALLOYDB_INSTANCE_URI=projects/PROJECT/locations/REGION/clusters/CLUSTER/instances/INSTANCE
ALLOYDB_DB=legalbot
ALLOYDB_USER=legalbot-app
ALLOYDB_PASSWORD=
ALLOYDB_IP_TYPE=PRIVATE
ALLOYDB_POOL_MIN=1
ALLOYDB_POOL_MAX=10
ALLOYDB_SA_KEY=

# Direct PostgreSQL for local development/integration tests.
# Used when USE_ALLOYDB=false by the async RAG query path.
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/legalbot
